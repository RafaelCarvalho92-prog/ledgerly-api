{
  "name": "ledgerly-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ledgerly API - multi-tenant invoicing & expenses REST API (Fastify, TypeScript, Drizzle, SQLite/Postgres).",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "openapi": "tsx scripts/openapi.ts",
    "docs": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=coverage/test-results.json && tsx scripts/build-docs.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "zip:source": "node scripts/zip-source.mjs"
  },
  "dependencies": {
    "@fastify/cors": "10.0.1",
    "@fastify/helmet": "12.0.1",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/swagger": "9.4.0",
    "bcryptjs": "2.4.3",
    "drizzle-orm": "0.36.4",
    "fastify": "5.1.0",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "4.0.2",
    "jose": "5.9.6",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.9.0",
    "@vitest/coverage-v8": "2.1.5",
    "eslint": "9.15.0",
    "eslint-config-prettier": "9.1.0",
    "fflate": "0.8.2",
    "globals": "15.12.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.3.3",
    "redoc": "2.2.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "8.15.0",
    "vitest": "2.1.5"
  },
  "overrides": {
    "zod-to-json-schema": "3.23.5"
  }
}
